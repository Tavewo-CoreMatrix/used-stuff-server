    "@paystack/paystack-sdk": "^1.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.79.1",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.44.0",
    "pg": "^8.16.0",
    "resend": "^6.12.4",
    "sharp": "^0.35.1",
    "tesseract.js": "^7.0.0"
  },
