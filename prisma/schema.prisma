generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  BUYER
  SELLER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  ARCHIVED
}

enum TransactionStatus {
  PENDING
  ESCROW_HELD
  SELLER_DISPATCHED
  BUYER_VERIFIED
  PAYOUT_RELEASED
  DISPUTED
  CANCELLED
}

enum WantedRequestStatus {
  ACTIVE     // still waiting for a match
  FULFILLED  // a matching listing was found and the requester was notified
  CANCELLED  // requester removed it manually
}

model Account {
  id               String        @id @default(cuid())
  email            String        @unique
  phone            String?       @unique
  passwordHash     String
  role             AccountRole   @default(BUYER)
  status           AccountStatus @default(ACTIVE)
  // Email verification
  emailVerified    Boolean       @default(false)
  otpCode          String?       // bcrypt-hashed OTP
  otpExpiresAt     DateTime?
  // Password reset
  resetToken       String?       // bcrypt-hashed reset token
  resetTokenExpiresAt DateTime?
  profile          Profile?
  bankAccount      BankAccount?
  pushToken        String?
  // Stable, randomly-generated pseudonym shown to buyers instead of this
  // account's real identity when it's acting as a seller. Generated lazily
  // on first use, not at signup, so it never leaks who has vs. hasn't sold yet.
  publicAlias      String?
  // Replaces password re-entry for sensitive in-session actions (e.g.
  // changing a saved bank account). Set up once (requires the current
  // password to establish), then used instead of it going forward.
  securityQuestion     String?
  securityAnswerHash   String? // hashed via the same scrypt helper as passwordHash
  // Set when an admin suspends the account; cleared on reinstatement.
  suspensionReason     String?
  suspendedAt          DateTime?
  items            Item[]
  listings         Listing[]
  purchases        Transaction[] @relation("BuyerTransactions")
  sales            Transaction[] @relation("SellerTransactions")
  wantedRequests   WantedRequest[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([email])
  @@index([phone])
}

model Profile {
  id          String   @id @default(cuid())
  accountId   String   @unique
  displayName String
  avatarUrl   String?
  city        String?
  state       String?
  country     String?  @default("Nigeria")
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
}

model Item {
  id          String        @id @default(cuid())
  ownerId     String
  title       String
  description String?
  category    String
  subcategory String?
  brand       String?
  condition   ItemCondition
  imageUrls   String[]
  owner       Account       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings    Listing[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId])
  @@index([category])
  @@index([subcategory])
}

model Listing {
  id                String        @id @default(cuid())
  sellerId          String
  itemId            String
  price             Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")
  status            ListingStatus @default(DRAFT)
  quantity          Int           @default(1)
  quantityAvailable Int           @default(1)
  locationCity      String?
  negotiable        Boolean       @default(false)
  deliveryAvailable Boolean       @default(false)
  pickupAvailable   Boolean       @default(false)
  // Set when an admin takes the listing down; blocks the seller (and order cancellations) from reactivating it.
  removedByAdminAt  DateTime?
  removalReason     String?
  seller            Account       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  item              Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([sellerId])
  @@index([itemId])
  @@index([status])
}

model Transaction {
  id                     String            @id @default(cuid())
  orderNumber            String            @unique
  listingId              String
  buyerId                String
  sellerId               String
  quantity               Int               @default(1)
  amount                 Decimal           @db.Decimal(12, 2)
  currency               String            @default("NGN")
  status                 TransactionStatus @default(PENDING)
  paymentReference       String?           @unique
  paymentTransactionHash String?           @unique
  escrowHeldAt           DateTime?
  sellerDispatchedAt     DateTime?
  sellerDispatchReference String?
  buyerVerifiedAt        DateTime?
  buyerVerificationNote  String?
  deliveryAddress        Json?
  disputeReason          String?
  disputeOpenedAt        DateTime?
  cancelledAt            DateTime?
  payoutReleasedAt       DateTime?
  payoutTransferCode     String?           @unique
  payoutSettledAt        DateTime?
  payoutFailedAt         DateTime?
  payoutFailureReason    String?
  inspectionDeadlineAt   DateTime?
  listing                Listing           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer                  Account           @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Restrict)
  seller                 Account           @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Restrict)
  stateHistories         StateHistory[]
  disputeEvidence        DisputeEvidence[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([paymentReference])
  @@index([paymentTransactionHash])
  @@index([status])
  @@index([orderNumber])
}

model StateHistory {
  id            String             @id @default(cuid())
  transactionId String
  fromStatus    TransactionStatus?
  toStatus      TransactionStatus
  reason        String?
  metadata      Json?
  transaction   Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())

  @@index([transactionId])
  @@index([toStatus])
}

model BankAccount {
  id            String   @id @default(cuid())
  accountId     String   @unique
  bankCode      String
  accountNumber String
  accountName   String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId])
}

// "Find It" — a buyer searches for something with no matching listing, and
// asks to be notified once a seller posts something that matches.
model WantedRequest {
  id               String              @id @default(cuid())
  requesterId      String
  requester        Account             @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  query            String              // raw search text, e.g. "Black Nike Shoe"
  category         String?             // best-effort inferred, e.g. "Fashion"
  subcategory      String?             // e.g. "Shoes" — shown to the user as the more specific label
  status           WantedRequestStatus @default(ACTIVE)
  matchedListingId String?             // set when a match notifies the requester
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  fulfilledAt      DateTime?

  @@index([requesterId])
  @@index([status])
}

// Append-only record of admin actions (suspensions, dispute rulings, ...).
// adminEmail is a snapshot so the trail stays readable if an admin account changes.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String   // e.g. ACCOUNT_SUSPENDED, ACCOUNT_REINSTATED, DISPUTE_RELEASED, DISPUTE_REFUNDED
  targetType String   // "ACCOUNT" | "TRANSACTION"
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([adminId])
  @@index([createdAt])
}

// Photos and notes the buyer or seller attach to an open dispute for the admin to review.
model DisputeEvidence {
  id            String      @id @default(cuid())
  transactionId String
  submittedById String
  submitterRole String      // "BUYER" | "SELLER"
  note          String      @default("")
  imageUrls     String[]
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}
