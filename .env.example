NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://postgres.ckkrtjppsgdiykcuiocn:EOcwLqK8FLBZLZEu@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Auth
AUTH_TOKEN_SECRET="replace-with-at-least-32-random-characters"
AUTH_TOKEN_EXPIRES_IN_SECONDS=604800

# CORS (comma-separated — required in production)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Paystack
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
FLUTTERWAVE_SECRET_HASH="your_secret_hash_here"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Used Stuff <noreply@yourdomain.com>"

# OTP & password reset TTL
OTP_EXPIRES_IN_MINUTES=15
RESET_TOKEN_EXPIRES_IN_MINUTES=15

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# OpenAI (AI verification — optional, only needed if using AI listing checks)
OPENAI_API_KEY="sk-proj-..."

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# BullBoard queue dashboard — use a strong password in production
BULL_BOARD_USERNAME="admin"
BULL_BOARD_PASSWORD="change-me-in-production"
